# Database Configuration (Defaults to local SQLite for zero-config evaluation; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./resume_matcher.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_matcher

# AI / Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SEMANTIC_SKILL_THRESHOLD=0.72

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
